{
  "name": "crom-api-webhook-sample",
  "version": "2.0.0",
  "description": "Crom Services public sample: HMAC-verified webhook endpoint",
  "private": true,
  "type": "module",
  "starter": {
    "config": {
      "name": "api-webhook-sample",
      "description": "A scoped Express webhook receiver: POST /webhook checks an HMAC-SHA256 signature over the raw body and replies 200 or 401.",
      "liveUrl": "https://crom-api-webhook-demo.fly.dev",
      "source": "CromServices/crom-ts-api-starter",
      "ref": "b2cd23a"
    }
  },
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*/*.test.ts",
    "check:banned": "node scripts/ci/banned-patterns.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
