{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "shared/**/*", "features/**/*"],
  "exclude": ["features/**/test/**/*", "node_modules", "dist"]
}
